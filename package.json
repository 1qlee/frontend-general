{
  "name": "frontend-interview-gym",
  "private": true,
  "version": "1.0.0",
  "description": "An interactive 2-week course to sharpen frontend fundamentals, system design and agentic development with Claude Code for interviews.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --config vite.sandbox.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "validate": "vitest run src/content"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.13.1",
    "@lezer/highlight": "1.2.5",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@uiw/react-codemirror": "4.23.14",
    "dom-accessibility-api": "0.7.0",
    "highlight.js": "11.11.1",
    "marked": "15.0.12",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "typescript": "5.8.3"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "26.1.0",
    "vite": "6.4.5",
    "vitest": "4.1.12"
  }
}
